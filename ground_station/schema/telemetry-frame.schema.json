{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andromeda.invalid/schema/telemetry-frame-v1.json",
  "title": "Andromeda ground-station telemetry frame v1",
  "type": "object",
  "required": ["schema_version", "sequence", "source", "mission_time_s", "phase", "attitude", "position"],
  "oneOf": [
    {"required": ["timestamp"]},
    {"required": ["timestamp_unix_ms"]}
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "timestamp_unix_ms": {"type": "number"},
    "source": {"type": ["string", "object"]},
    "mission_time_s": {"type": "number"},
    "phase": {"type": "string", "minLength": 1},
    "attitude": {
      "type": "object",
      "required": ["valid", "quaternion"],
      "properties": {
        "valid": {"type": "boolean"},
        "quality": {"type": "string"},
        "quaternion": {
          "type": "object",
          "required": ["w", "x", "y", "z"],
          "properties": {
            "w": {"type": "number"}, "x": {"type": "number"},
            "y": {"type": "number"}, "z": {"type": "number"}
          }
        }
      }
    },
    "position": {
      "type": "object",
      "required": ["valid", "latitude_deg", "longitude_deg", "altitude_m"],
      "properties": {
        "valid": {"type": "boolean"},
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitude_m": {"type": "number", "description": "Launch-site AGL altitude"}
      }
    },
    "velocity_ned_m_s": {"$ref": "#/$defs/nedVector"},
    "acceleration_body_m_s2": {"$ref": "#/$defs/bodyVector"},
    "angular_rate_body_rad_s": {"$ref": "#/$defs/bodyVector"}
  },
  "$defs": {
    "bodyVector": {
      "type": "object", "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
    },
    "nedVector": {
      "type": "object", "required": ["north", "east", "down"],
      "properties": {"north": {"type": "number"}, "east": {"type": "number"}, "down": {"type": "number"}}
    }
  },
  "additionalProperties": true
}
