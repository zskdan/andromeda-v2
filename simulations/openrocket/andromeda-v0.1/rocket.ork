        <winddirection>1.5707963267948966</winddirection>
        <wind model="average">
          <speed>5.0</speed>
          <direction>1.5707963267948966</direction>
          <standarddeviation>0.5</standarddeviation>
        </wind>
        <wind model="multilevel" altituderef="msl">
          <windlevel altitude="200.0" speed="5.0" direction="1.5707963267948966" standarddeviation="0.5"/>
        </wind>
        <windmodeltype>Average</windmodeltype>
        <launchaltitude>200.0</launchaltitude>
        <launchlatitude>24.0</launchlatitude>
        <launchlongitude>54.0</launchlongitude>
        <geodeticmethod>spherical</geodeticmethod>
        <atmosphere model="isa"/>
        <timestep>0.02</timestep>
        <maxtime>1200.0</maxtime>
      </conditions>
